# Sub-Terra Rover - start rover_pi.py at boot
#
# Install (on the Pi, once). Edit User / paths below if yours differ.
#   sudo cp rover_pi.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rover_pi
#
# Useful:
#   systemctl status rover_pi        # is it running?
#   journalctl -u rover_pi -f        # live output (same as running it by hand)
#   sudo systemctl stop rover_pi     # stop it (do this before running the script by hand)
#   sudo systemctl disable rover_pi  # stop starting at boot

[Unit]
Description=Sub-Terra Rover Pi recorder
After=multi-user.target local-fs.target

[Service]
Type=simple
User=yunus
WorkingDirectory=/home/yunus/dev
ExecStart=/usr/bin/python3 -u /home/yunus/dev/rover_pi.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
